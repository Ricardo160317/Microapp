# Cliente de IA compatible con OpenAI (usado por generateBlueprint)
# baseURL de la API compatible con OpenAI. Ejemplos:
#   DeepSeek:  https://api.deepseek.com/v1
#   Gemini (vía proxy compatible con OpenAI): https://generativelanguage.googleapis.com/v1beta/openai/
IA_BASE_URL=https://api.deepseek.com/v1
IA_API_KEY=
IA_MODELO=deepseek-chat

# Supabase (Postgres + Auth). Datos del proyecto en supabase.com/dashboard,
# sección Project Settings > API.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
# Clave con privilegios de servidor: bypassa RLS, crea usuarios (admin API).
# NUNCA exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# apps/core-api
CORE_API_PORT=3001

# apps/builder-web (debe empezar con NEXT_PUBLIC_ para llegar al navegador)
NEXT_PUBLIC_API_URL=http://localhost:3001
